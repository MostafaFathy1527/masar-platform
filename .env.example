# Neon pooled connection string. Never commit the real value.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Sentry (error monitoring). The DSN is a public key; the auth token is not.
# SENTRY_AUTH_TOKEN is only needed where the build uploads source maps (Vercel).
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_AUTH_TOKEN="sntrys_..."

# Optional, only for pipeline/judge_bedrock.py (offline experiments). Standard AWS names.
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_DEFAULT_REGION="us-east-1"
