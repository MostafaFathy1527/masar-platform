# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
# Anchored: a bare `out/` matches any directory of that name at any depth, which
# silently swallowed pipeline/out — the pipeline's own deliverables, cited as
# evidence in docs/STATUS.md and counted by the how-it-was-built page. They never
# reached a deploy, so the live page reported 0 generated drafts while describing
# one in the same paragraph.
/out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# environment — .env.example IS committed (see HANDOVER.md)
.env
.env*
!.env.example
*.pem

# test + coverage
/coverage
/playwright-report
/test-results

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# deploy
.vercel

# os
.DS_Store
Thumbs.db

# machine-specific, never published (denylist, day-0 notes, local paths)
.local/

# python bytecode - compiled .pyc files embed the absolute source path,
# which is a local-path leak the publish gate correctly refuses
__pycache__/
*.py[cod]
.pytest_cache/
