# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# environment — .env.example IS committed (see HANDOVER.md)
.env
.env*
!.env.example
*.pem

# test + coverage
/coverage
/playwright-report
/test-results

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# deploy
.vercel

# os
.DS_Store
Thumbs.db

# machine-specific, never published (denylist, day-0 notes, local paths)
.local/

# python bytecode - compiled .pyc files embed the absolute source path,
# which is a local-path leak the publish gate correctly refuses
__pycache__/
*.py[cod]
.pytest_cache/
