// Masār — v1.0 schema.
//
// Scoped to what Weeks 1-2 actually need. Tables for assessment, simulations,
// certificates and the content pipeline arrive in their own migrations, as each
// week lands, so nothing is built for a feature the plan's cut lines may drop.
//
// Conventions: cuid ids, createdAt/updatedAt everywhere, enums for
// every state machine, bilingual fields as xAr/xEn pairs, soft deactivation
// over deletion.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from this block: the connection string for migrate
// lives in prisma.config.ts, and the client gets a driver adapter (see lib/db.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum Role {
  LEARNER
  ADMIN
}

enum Locale {
  ar
  en
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  locale          Locale    @default(ar)
  role            Role      @default(LEARNER)
  /// Guest accounts created by the one-click demo entry. Purged on a schedule.
  isDemo          Boolean   @default(false)
  /// Soft deactivation; rows are never hard-deleted.
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollments Enrollment[]
  simSubmissions SimSubmission[]
  attempts       Attempt[]
  certificates   Certificate[]
  orders         Order[]

  @@index([isDemo, createdAt])
}

// ------------------------------------------------------------------ course

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id         String       @id @default(cuid())
  slug       String       @unique
  titleAr    String
  titleEn    String
  summaryAr  String
  summaryEn  String
  /// Minor units. Sandbox/demo pricing only — no real money moves.
  priceEgp   Int          @default(0)
  priceUsd   Int          @default(0)
  status     CourseStatus @default(DRAFT)
  version    Int          @default(1)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  objectives  Objective[]
  modules     Module[]
  enrollments Enrollment[]
}

enum Bloom {
  RECALL
  APPLY
  ANALYZE
}

/// The spine: every block and every item carries an objectiveId, which makes
/// coverage, mastery and item analysis the same query.
model Objective {
  id           String   @id @default(cuid())
  courseId     String
  code         String
  statementAr  String
  statementEn  String
  bloom        Bloom
  weight       Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[] @relation("LessonObjectives")

  @@unique([courseId, code])
}

model Module {
  id         String   @id @default(cuid())
  courseId   String
  order      Int
  titleAr    String
  titleEn    String
  unlockRule String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
}

// ------------------------------------------------------------------ lesson

/// Depth is a property of a lesson, not a separate lesson. One row holds all
/// three block arrays, so adding L2 to an L1 lesson is an additive diff: no URL
/// change, no re-enrolment, no progress reset.
enum Level {
  L1
  L2
  L3
}

enum LessonStatus {
  DRAFT
  QA
  PUBLISHED
}

model Lesson {
  id         String       @id @default(cuid())
  moduleId   String
  order      Int
  slug       String       @unique
  titleAr    String
  titleEn    String
  estMinutes Int          @default(0)
  levels     Level[]
  /// Validated JSON, not a relational block store: a block table plus an editor
  /// over it roughly doubles the build for no visible benefit. Every block
  /// carries a stable id, so block-level analytics still work.
  blocksJson Json
  status     LessonStatus @default(DRAFT)
  isPreview  Boolean      @default(false)
  /// SHA-256 of the pipeline source note; a changed source flags this stale.
  sourceHash String?
  pipelineRunId String?
  qaScore    Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  objectives Objective[]      @relation("LessonObjectives")
  progress   LessonProgress[]

  @@unique([moduleId, order])
}

// ---------------------------------------------------------------- progress

enum EnrollmentSource {
  PURCHASE
  MANUAL
  GUEST_DEMO
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  source      EnrollmentSource
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  progressPct Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([userId, courseId])
}

enum ProgressState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

model LessonProgress {
  id           String        @id @default(cuid())
  enrollmentId String
  lessonId     String
  /// The depth the learner is reading at.
  level        Level         @default(L1)
  blocksDone   Int           @default(0)
  blocksTotal  Int           @default(0)
  state        ProgressState @default(NOT_STARTED)
  timeSpentSec Int           @default(0)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

// -------------------------------------------------------------- simulation

/// One simulation kind ships in v1.0. The correction pass cuts the others to
/// documented design patterns in SPEC.md, so this enum stays deliberately
/// narrow: widening it is a scope change, not a schema tidy-up.
enum SimulationKind {
  CLAIM_REVIEW
}

/// How a submission is scored. PRECISION_RECALL rewards reading carefully and
/// punishes flagging everything; the formula is published in the UI and the
/// case study, not buried here.
enum ScoringMode {
  PRECISION_RECALL
}

model Simulation {
  id              String         @id @default(cuid())
  courseId        String
  slug            String         @unique
  kind            SimulationKind
  objectiveIds    String[]
  /// The claim under review: fields, lines, total, the clinical note, and the
  /// member card. The card is what makes the demographic and date errors
  /// findable rather than guessable.
  datasetJson     Json
  /// The seeded errors, each with its class, its written explanation, and the
  /// id of the block that taught it.
  seededErrorsJson Json
  /// Reserved for kinds that self-assess against published criteria. Unused by
  /// CLAIM_REVIEW, which scores deterministically.
  rubricJson      Json?
  scoringMode     ScoringMode    @default(PRECISION_RECALL)
  passPct         Int            @default(70)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  submissions SimSubmission[]

  @@index([courseId])
}

model SimSubmission {
  id           String   @id @default(cuid())
  simulationId String
  userId       String
  /// What the learner flagged.
  responseJson Json
  /// The full breakdown: hits, misses, false positives, both score terms, and
  /// the per-error explanations. Stored so a review screen never recomputes a
  /// score and risks showing a different number than the one awarded.
  scoreJson    Json
  scorePct     Int
  passed       Boolean
  submittedAt  DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, simulationId])
}

// -------------------------------------------------------------- assessment

/// Two item types ship in v1.0. There is no scenario flag: an `isScenario`
/// boolean was hand-set on a third of the bank and reported as a
/// "scenario-led" percentage, while the longest flagged stem was less than
/// half the defined minimum length. It measured itself, not the property it
/// named, so it was removed rather than renamed. The wider set (MATCHING,
/// ORDERING, SCENARIO_MCQ, CASE_SET) is in LATER.md.
enum ItemType {
  MCQ_SINGLE
  MULTI_SELECT
}

enum ItemStatus {
  DRAFT
  LIVE
  RETIRED
}

enum AuthoredBy {
  HUMAN
  PIPELINE
}

/// LESSON is the short quiz at the end of a lesson; EXAM is the single
/// blueprint-sampled assessment. The module-quiz and mock/final split are cut
/// from v1.0.
enum AssessmentScope {
  LESSON
  EXAM
}

enum AttemptState {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Item {
  id          String     @id @default(cuid())
  courseId    String
  /// Objective code, e.g. MI-06. The spine: coverage, weakness reporting and
  /// item analysis are the same query because of this column.
  objectiveId String
  type        ItemType
  stemAr      String
  stemEn      String
  bloom       Bloom
  /// Formative items are in-lesson knowledge checks. Never scored, never in a
  /// gradebook, and never drawn into a quiz or exam.
  formative   Boolean    @default(false)
  /// Shown after an attempt is over, never during one.
  rationaleAr String
  rationaleEn String
  status      ItemStatus @default(DRAFT)
  authoredBy  AuthoredBy @default(HUMAN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  options ItemOption[]
  answers AttemptAnswer[]

  @@index([courseId, objectiveId, status])
}

model ItemOption {
  id         String  @id @default(cuid())
  itemId     String
  order      Int
  textAr     String
  textEn     String
  isCorrect  Boolean
  /// Required on every option, correct or not. A distractor without a
  /// rationale that names its misconception is a QA failure.
  feedbackAr String
  feedbackEn String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, order])
}

model Assessment {
  id           String          @id @default(cuid())
  courseId     String
  scope        AssessmentScope
  /// Lesson slug for a lesson quiz; null for the exam.
  scopeId      String?
  itemCount    Int
  timeLimitSec Int?
  passPct      Int             @default(70)
  /// Blueprint: how many items to draw per objective. Assembly fails loudly if
  /// a pool cannot satisfy it rather than silently serving fewer items.
  assemblyJson Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attempts Attempt[]

  @@index([courseId, scope])
}

model Attempt {
  id           String       @id @default(cuid())
  userId       String
  assessmentId String
  startedAt    DateTime     @default(now())
  submittedAt  DateTime?
  /// The item set is materialised server-side at start, so the server decides
  /// what was asked and a client cannot influence it afterwards.
  itemIdsJson  Json
  seed         String
  scorePct     Int?
  passed       Boolean?
  attemptNo    Int          @default(1)
  state        AttemptState @default(IN_PROGRESS)

  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]

  @@index([userId, assessmentId])
}

model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  itemId     String
  responseJson Json
  isCorrect  Boolean
  answeredAt DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([attemptId, itemId])
}

// ------------------------------------------------------------- certificate

model Certificate {
  id            String    @id @default(cuid())
  serial        String    @unique
  userId        String
  courseId      String
  issuedAt      DateTime  @default(now())
  finalScorePct Int
  /// Objectives the holder demonstrated. Printed on the certificate: a
  /// credential that says what you can do beats one that says you attended.
  objectivesMet String[]
  /// sha256 over the identifying fields, so a printed copy can be checked
  /// against the record. The verify URL is the source of truth, never the PDF.
  payloadHash   String
  revokedAt     DateTime?
  revokeReason  String?
  /// True when issued through the demo shortcut rather than by meeting gates.
  isDemo        Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------- payments

/// v1.0 activates no payment provider. MOCK is the only adapter that runs;
/// the others are named so the interface is honest about what it is shaped
/// for, and documented in SPEC.md as proposal material rather than code.
enum PaymentProvider {
  MOCK
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

model Order {
  id          String          @id @default(cuid())
  userId      String
  courseId    String
  provider    PaymentProvider @default(MOCK)
  /// Unique per provider reference, which is what makes webhook replay safe:
  /// the same reference can only ever produce one order.
  providerRef String          @unique
  amountMinor Int
  currency    String
  status      OrderStatus     @default(PENDING)
  /// A real database column, not a UI string. No real money moves in v1.0 and
  /// the record says so permanently.
  isSandbox   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}
